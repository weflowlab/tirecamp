# 이 파일을 복사해 .env.local 로 저장하고 값을 채우세요 (.env.local 은 git 에 올라가지 않음)

# --- Neon Postgres ---
# 있으면 문의/후기/회원/공지/FAQ/팝업/방문기록/업로드 이미지를 모두 DB 에 저장합니다.
# 없으면 data/*.json 파일에 저장합니다 (로컬 개발용, Vercel 등 읽기 전용 호스팅에서는 동작하지 않음).
DATABASE_URL=

# --- 관리자 페이지 (/admin) ---
# 운영에서는 필수. 개발 환경에서 비워 두면 "tirecamp" 로 로그인됩니다.
ADMIN_PASSWORD=
# 세션 쿠키 서명 키 (선택, 비우면 ADMIN_PASSWORD 로 서명). 아무 긴 문자열이나 넣으세요.
ADMIN_SESSION_SECRET=
